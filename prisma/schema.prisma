generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  STAFF
}

enum NoticeType {
  GLOBAL
  TEACHER
}

enum InstitutionType {
  PRIMARY_SCHOOL
  HIGH_SCHOOL
  COLLEGE
  UNIVERSITY
  OTHER
}

model User {
  id              String    @id @default(cuid())
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  phone           String?   @db.VarChar(20)
  status          Boolean   @default(true)
  email           String    @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String    @db.VarChar(255)
  role            UserRole  @default(ADMIN)
  avatarId        String?   @map("avatar_id")
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  avatar          Image?        @relation("user_avatars", fields: [avatarId], references: [id])
  institutions    Institution[]
  students        Student[]
  teachers        Teacher[]
  noticesCreated  Notice[]      @relation("notice_creator")
  noticesReceived Notice[]      @relation("user_notice")
  orders          Order[]
  staff           Staff?

  @@index([email], name: "user_email_index")
  @@map("users")
}

