// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  STAFF
}

enum NoticeType {
  GLOBAL
  TEACHER
}

model User {
  id               String            @id @default(cuid())
  avatar           Int?
  firstName        String            @map("first_name")
  lastName         String            @map("last_name")
  phone            String?
  status           Boolean           @default(true)
  email            String            @unique
  emailVerifiedAt  DateTime?         @map("email_verified_at")
  password         String
  role             UserRole          @default(ADMIN)
  rememberToken    String?           @map("remember_token")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deleted          Boolean           @default(false)
  
  institutions     Institution[]
  students         Student[]
  teachers         Teacher[]
  noticesCreated   Notice[]
  staff            Staff?
  
  @@index([email])
  @@map("users")
}

model Institution {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  uuid            String     @db.Uuid
  name            String
  registrationNo  String?    @map("registration_no")
  noOfStudents    Int?       @map("no_of_students")
  noOfTeachers    Int?       @map("no_of_teachers")
  type            String     @default("PRIMARY_SCHOOL")
  coverPhoto      Int?       @map("cover_photo")
  logo            Int?       @map("logo")
  location        String?
  contactNumber   String?
  address         String?
  status          Boolean    @default(true)
  limit           Int?
  extraInfos      Json?      @map("extra_infos")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deleted         Boolean    @default(false)
  
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  levels          Level[]
  students        Student[]
  subjects        Subject[]
  teachers        Teacher[]
  notices         Notice[]
  staffs          Staff[]
  
  @@index([name])
  @@map("institutions")
}

model Level {
  id             String     @id @default(cuid())
  institutionId  String     @map("institution_id")
  name           String
  hasShift       Boolean    @default(false)
  hasGroup       Boolean    @default(false)
  hasSection     Boolean    @default(false)
  status         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  groups         Group[]
  sections       Section[]
  shifts         Shift[]
  students       Student[]
  subjects       Subject[]
  teacherAssigns TeacherAssign[]
  routines       Routine[]
   Notice         Notice[]
  
  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("levels")
}

model Group {
  id             String     @id @default(cuid())
  levelId        String?    @map("level_id")
  name           String
  status         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  level          Level?     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  sections       Section[]
  shifts         Shift[]
  students       Student[]
  notices        Notice[]
  
  @@unique([levelId, name])
  @@index([levelId])
  @@map("groups")
}

model Section {
  id             String     @id @default(cuid())
  levelId        String     @map("level_id")
  groupId        String?    @map("group_id")
  name           String
  status         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  level          Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  group          Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  students       Student[]
  teacherAssigns TeacherAssign[]
  notices        Notice[]
  
  @@unique([levelId, name])
  @@index([levelId])
  @@map("sections")
}

model Shift {
  id             String     @id @default(cuid())
  levelId        String     @map("level_id")
  groupId        String?    @map("group_id")
  name           String
  status         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  level          Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  group          Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  notices        Notice[]
  
  @@unique([levelId, name])
  @@index([levelId])
  @@map("shifts")
}

model Student {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  institutionId  String     @map("institution_id")
  levelId        String     @map("level_id")
  sectionId      String?    @map("section_id")
  groupId        String?    @map("group_id")
  rollNo         String?    @map("roll_no")
  joiningDate    DateTime?  @map("joining_date")
  address        String?
  status         Boolean    @default(true)
  extraInfos     Json?      @map("extra_infos")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  level          Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  section        Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  group          Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attendances    Attendance[]
  assignments    AssignmentSubmission[]
  examResults    ExamResult[]
  
  @@unique([institutionId, rollNo])
  @@index([institutionId])
  @@index([levelId])
  @@map("students")
}

model Subject {
  id             String     @id @default(cuid())
  institutionId  String     @map("institution_id")
  levelId        String     @map("level_id")
  name           String
  code           String?
  creditHours    Float?
  description    String?
  status         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  level          Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  teacherAssigns TeacherAssign[]
  notices        Notice[]
  teachers       SubjectTeacher[]
  assignments    Assignment[]
  attendances    Attendance[]
  examResults    ExamResult[]
  routineSlots   RoutineSlot[]
  
  @@unique([institutionId, code], name: "subject_code_unique")
  @@index([institutionId])
  @@index([levelId])
  @@map("subjects")
}

model Teacher {
  id             String     @id @default(cuid())
  institutionId  String     @map("institution_id")
  userId         String     @map("user_id") @unique
  pdsId          String?    @map("pds_id")
  designation    String
  joiningDate    DateTime?  @map("joining_date")
  address        String?
  district       String?
  specialization String?
  status         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherAssigns TeacherAssign[]
  notices        Notice[]
  subjects       SubjectTeacher[]
  routineSlots   RoutineSlot[]
  
  @@index([institutionId])
  @@map("teachers")
}

model Staff {
  id             String     @id @default(cuid())
  userId         String     @map("user_id") @unique
  institutionId  String     @map("institution_id")
  designation    String
  joiningDate    DateTime?  @map("joining_date")
  status         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  @@index([institutionId])
  @@map("staffs")
}

model Notice {
  id             String     @id @default(cuid())
  institutionId  String     @map("institution_id")
  groupId        String?    @map("group_id")
  levelId        String?    @map("level_id")
  subjectId      String?    @map("subject_id")
  sectionId      String?    @map("section_id")
  shiftId        String?    @map("shift_id")
  createdBy      String     @map("created_by")
  teacherId      String?    @map("teacher_id")
  status         Boolean    @default(true)
  isPinned       Boolean    @default(false) @map("is_pinned")
  title          String?
  body           String?    @db.Text
  type           NoticeType @default(GLOBAL)
  attachment     Int?
  publishedAt    DateTime   @default(now()) @map("published_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  group          Group?     @relation(fields: [groupId], references: [id])
  level          Level?     @relation(fields: [levelId], references: [id])
  subject        Subject?   @relation(fields: [subjectId], references: [id])
  section        Section?   @relation(fields: [sectionId], references: [id])
  shift          Shift?     @relation(fields: [shiftId], references: [id])
  creator        User       @relation(fields: [createdBy], references: [id])
  teacher        Teacher?   @relation(fields: [teacherId], references: [id])
  
  @@index([institutionId])
  @@index([teacherId])
  @@index([levelId])
  @@map("notices")
}

model TeacherAssign {
  id             String     @id @default(cuid())
  teacherId      String     @map("teacher_id")
  levelId        String     @map("level_id")
  sectionId      String     @map("section_id")
  subjectId      String     @map("subject_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deleted        Boolean    @default(false)
  
  teacher        Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  level          Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  section        Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  @@unique([teacherId, levelId, sectionId, subjectId], name: "unique_teacher_assignment")
  @@index([teacherId])
  @@index([levelId])
  @@index([sectionId])
  @@index([subjectId])
  @@map("teacher_assigns")
}

model SubjectTeacher {
  id          String    @id @default(cuid())
  subjectId   String    @map("subject_id")
  teacherId   String    @map("teacher_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deleted     Boolean   @default(false)

  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@index([subjectId])
  @@index([teacherId])
  @@map("subject_teachers")
}

model Routine {
  id           String       @id @default(cuid())
  levelId      String       @map("level_id")
  semester     String?
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deleted      Boolean      @default(false)

  level        Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  slots        RoutineSlot[]

  @@index([levelId])
  @@map("routines")
}

model RoutineSlot {
  id          String     @id @default(cuid())
  routineId   String     @map("routine_id")
  subjectId   String     @map("subject_id")
  teacherId   String     @map("teacher_id")
  dayOfWeek   Int        @map("day_of_week") // 1-7 for Monday-Sunday
  startTime   DateTime   @map("start_time")
  endTime     DateTime   @map("end_time")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deleted     Boolean    @default(false)

  routine     Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([subjectId])
  @@index([teacherId])
  @@map("routine_slots")
}

model Attendance {
  id          String     @id @default(cuid())
  subjectId   String     @map("subject_id")
  studentId   String     @map("student_id")
  date        DateTime
  isPresent   Boolean    @default(false) @map("is_present")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deleted     Boolean    @default(false)

  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([subjectId, studentId, date])
  @@index([subjectId])
  @@index([studentId])
  @@map("attendances")
}

model Assignment {
  id          String     @id @default(cuid())
  subjectId   String     @map("subject_id")
  title       String
  description String     @db.Text
  dueDate     DateTime   @map("due_date")
  totalMarks  Float      @map("total_marks")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deleted     Boolean    @default(false)

  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([subjectId])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  assignmentId  String     @map("assignment_id")
  studentId     String     @map("student_id")
  submissionUrl String     @map("submission_url")
  marks         Float?
  submittedAt   DateTime   @default(now()) @map("submitted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deleted       Boolean    @default(false)

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model ExamResult {
  id          String     @id @default(cuid())
  subjectId   String     @map("subject_id")
  studentId   String     @map("student_id")
  examType    String     @map("exam_type") // Midterm, Final, etc.
  marks       Float
  grade       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deleted     Boolean    @default(false)

  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([subjectId, studentId, examType])
  @@index([subjectId])
  @@index([studentId])
  @@map("exam_results")
}

// Assuming there's an Images table referenced by foreign keys
model Image {
  id         String     @id @default(cuid())
  path       String
  filename   String
  mimetype   String
  size       Int
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deleted    Boolean    @default(false)
  
  @@map("images")
}